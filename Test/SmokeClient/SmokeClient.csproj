<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>smokeclient</AssemblyName>
    <RootNamespace>SuperSocketLite.SmokeClient</RootNamespace>
    <!-- 라이브러리를 참조하지 않는다. 클라이언트 쪽에서 본 프로토콜만 다루므로
         서버 구현과 독립적으로 검증할 수 있다. -->
  </PropertyGroup>

</Project>
